# TerraSync environment template. Copy to .env and fill in.
#   cp env.example .env        (Windows: copy env.example .env)
# Never commit .env.

# --- App mode ---------------------------------------------------------------
# Development: dev-OTP shortcut on, cookies not Secure-only.
# Hosted/real use: FLASK_ENV=production, remove FLASK_DEBUG, COOKIE_SECURE=true.
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
COOKIE_SECURE=false

# --- MySQL ------------------------------------------------------------------
# (docker compose overrides DB_HOST to "db" automatically)
DB_HOST=localhost
DB_PORT=3306
DB_USER=terrasync_app
DB_PASSWORD=change-me-to-your-db-password
DB_NAME=terrasync

# --- Gemini AI (server-side secret; never expose in HTML/JS) -----------------
# Get a key at https://aistudio.google.com/apikey . Blank = run without AI:
# reports are still filed and flagged "needs review".
GEMINI_API_KEY=
GEMINI_ENABLED=true
# Primary model, then an automatic fallback if it is unavailable, rate-limited
# or returns invalid output. Use model IDs your key can access.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Per-request timeout so a slow Gemini call can't hang a citizen's report.
GEMINI_TIMEOUT_SECONDS=25
# Optional: minimal | low | medium | high  (lower = faster/cheaper triage)
GEMINI_THINKING_LEVEL=
# Trust policy: only confident (>= 0.5), non-duplicate AI tickets are auto-assigned.
AI_AUTO_ASSIGN=true
# Cost guard: max Gemini-analysed reports per citizen per hour (extra reports are still filed).
AI_MAX_PER_CITIZEN_PER_HOUR=10
# Duplicate check radius (metres) around the report's GPS point.
DUPLICATE_RADIUS_METERS=300

# --- SMS (login OTPs + complaint notifications) ------------------------------
# console = print messages to the server log (default for dev/demo)
# twilio  = send real SMS (fill the TWILIO_* values; India needs DLT registration)
SMS_PROVIDER=console
SMS_NOTIFICATIONS_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Set either a sender number or a messaging service SID:
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# --- Docker / HTTPS (docker-compose.yml) -------------------------------------
DB_ROOT_PASSWORD=change-me-root
# Public domain for automatic HTTPS via Caddy (needed for mic + GPS in browsers).
# Leave empty unless using: docker compose --profile https up -d --build
DOMAIN=
# Interface for the app's port 8000. Use 127.0.0.1 when Caddy (HTTPS) fronts the app.
WEB_BIND=0.0.0.0

# --- Gunicorn tuning (optional; defaults shown) ------------------------------
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=90
# PORT=8000
